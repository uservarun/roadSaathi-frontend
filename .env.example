# Copy this file to .env and adjust if your backend runs elsewhere
VITE_API_BASE_URL=http://localhost:8080

# Google Maps JavaScript API key — required for all map views (PlanRoute,
# Nearby Hazards). Get one from https://console.cloud.google.com/google/maps-apis
# (enable "Maps JavaScript API", create an API key, and restrict it to your
# domain / localhost). See README.md for step-by-step instructions.
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
